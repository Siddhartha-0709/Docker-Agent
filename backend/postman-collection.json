{
  "info": {
    "name": "Docker Agent API",
    "description": "Complete API collection for Docker Agent Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "ws_url",
      "value": "ws://localhost:3001",
      "type": "string"
    },
    {
      "key": "container_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "image_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "network_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "volume_name",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Containers",
      "item": [
        {
          "name": "Get All Containers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/containers/getAll",
              "host": ["{{base_url}}"],
              "path": ["containers", "getAll"]
            }
          }
        },
        {
          "name": "Start Container",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/containers/start?id={{container_id}}",
              "host": ["{{base_url}}"],
              "path": ["containers", "start"],
              "query": [
                {
                  "key": "id",
                  "value": "{{container_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Stop Container",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/containers/stop?id={{container_id}}",
              "host": ["{{base_url}}"],
              "path": ["containers", "stop"],
              "query": [
                {
                  "key": "id",
                  "value": "{{container_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Restart Container",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/containers/restart?id={{container_id}}",
              "host": ["{{base_url}}"],
              "path": ["containers", "restart"],
              "query": [
                {
                  "key": "id",
                  "value": "{{container_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Remove Container",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/containers/remove?id={{container_id}}",
              "host": ["{{base_url}}"],
              "path": ["containers", "remove"],
              "query": [
                {
                  "key": "id",
                  "value": "{{container_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Inspect Container",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/containers/inspect?id={{container_id}}",
              "host": ["{{base_url}}"],
              "path": ["containers", "inspect"],
              "query": [
                {
                  "key": "id",
                  "value": "{{container_id}}"
                }
              ]
            }
          }
        }
